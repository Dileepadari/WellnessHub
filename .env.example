# Copy to .env and fill in. .env is gitignored and must never be committed.

# --- Runtime ---
NODE_ENV=development
PORT=5000
LOG_LEVEL=debug

# --- Database ---
# The server reads MONGODB_URI. The MONGO_* values below are only used by
# docker-compose to provision the mongodb container and build this URI.
MONGODB_URI=mongodb://localhost:27017/wellnesshub
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=change-me
MONGO_DB_NAME=wellnesshub
MONGO_PORT=27017

# --- Auth ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# The server refuses to start in production if this is left as the example value.
JWT_SECRET=your-super-secret-jwt-key-change-in-production-environment
JWT_EXPIRE=7d

# --- CORS ---
# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGIN=http://localhost:3000

# --- Rate limiting ---
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX=100

# --- Frontend (Vite inlines these at build time) ---
# Leave as /api to use the dev proxy and the production nginx proxy.
VITE_API_URL=/api
FRONTEND_PORT=3000
